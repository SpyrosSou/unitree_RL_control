# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb
.venv/

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode
.vscode/browse.vc.db
.vscode/browse.vc.db-shm
.vscode/browse.vc.db-wal

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp
nohup.out

# Eval run outputs (timestamped dirs of generated CSVs — the eval *scripts* themselves,
# which live as .py files directly in these same validation/ directories, are unaffected
# by a trailing-slash/subdirectory-only pattern like this).
validation/eval_standing_ikreach/*/
validation/integration_validation/*/

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*
**/*.pt

# Curated deployable checkpoints kept in-repo
!chosen_checkpoints/
!chosen_checkpoints/*.pt
!chosen_checkpoints/*.md
# Exported deployment artifacts (ONNX + the .pt it was exported from) — the .pt here would
# otherwise still be caught by **/*.pt above; the blanket chosen_checkpoints exception only
# covers files directly in that directory, not this subdirectory (2026-07-13, found while
# checking why chosen_checkpoints/exported/ was showing as untracked-but-partially-ignored).
!chosen_checkpoints/exported/
!chosen_checkpoints/exported/*
# Same subdirectory-exception issue as exported/ above (2026-07-21, 23_dof branch archive).
!chosen_checkpoints/best_checkpoints/
!chosen_checkpoints/best_checkpoints/*.pt
!chosen_checkpoints/archive/
!chosen_checkpoints/archive/*.pt

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Personal notes / learning material
/personal_development/

# Tests
tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*
